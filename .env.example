# ============================================================================
# RobotOps AI —— Phase 2 环境变量示例
#
# 使用方法：
#   1) 复制本文件为 .env（与 main.py 同目录，文件名就是 .env）
#   2) 把 DEEPSEEK_API_KEY 替换为你的真实密钥，保存后即可运行 python main.py
#
# 安全约定：
#   - .env 已被 .gitignore 忽略，请勿把真实密钥写入本示例文件或提交到 Git；
#   - API Key 只通过环境变量读取，代码中没有任何硬编码密钥。
# ============================================================================

# 【必填】DeepSeek API Key
# 获取方式：登录 https://platform.deepseek.com/ → API Keys → 创建密钥（形如 sk-xxxxxxxx）
DEEPSEEK_API_KEY=sk-请替换为你的真实密钥

# ---------------------------------------------------------------------------
# 【可选】以下参数均有默认值，不填即可；默认值统一定义在 robotops/llm/config.py
# ---------------------------------------------------------------------------
# API 地址（OpenAI 兼容接口）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名称：deepseek-chat（通用对话，推荐）/ deepseek-reasoner（推理模型）
# DEEPSEEK_MODEL=deepseek-chat

# 单次请求超时（秒）
# DEEPSEEK_TIMEOUT=60

# 失败自动重试次数（限流 / 服务端错误 / 超时 / 网络错误会指数退避重试）
# DEEPSEEK_MAX_RETRIES=2

# 采样温度（0~2，越低越稳定，分析类任务建议 0~0.3）
# DEEPSEEK_TEMPERATURE=0.2

# 单次最大输出长度（token）
# DEEPSEEK_MAX_TOKENS=4096

# 日志级别：DEBUG / INFO / WARNING / ERROR
# DEEPSEEK_LOG_LEVEL=INFO

# 自定义 .env 文件位置（默认读取项目根目录的 .env）
# ROBOTOPS_ENV_FILE=D:\我的配置\robotops.env

# ---------------------------------------------------------------------------
# 【可选】Phase 3 RAG 知识库参数（默认值定义在 robotops/rag/config.py）
# ---------------------------------------------------------------------------
# 知识库目录（默认 knowledge/）
# ROBOTOPS_KNOWLEDGE_DIR=knowledge

# 向量数据库（ChromaDB）持久化目录（默认 data/chroma）
# ROBOTOPS_CHROMA_DIR=data/chroma

# 集合名称
# ROBOTOPS_RAG_COLLECTION=robot_ops_cases

# 检索 Top-K 与最多注入提示词的案例数
# ROBOTOPS_RAG_TOP_K=5
# ROBOTOPS_RAG_MAX_CASES=6

# 最低相似度阈值（低于该值的命中会被过滤；调低会召回更多但噪声更多）
# ROBOTOPS_RAG_MIN_SIMILARITY=0.35

# Embedding 方案与维度（当前仅支持本地哈希向量）
# ROBOTOPS_EMBEDDING_BACKEND=local_hashing
# ROBOTOPS_EMBEDDING_DIM=1024

# 索引缺失时是否自动构建（false 时需要手动执行 rebuild 命令）
# ROBOTOPS_RAG_AUTO_BUILD=true
