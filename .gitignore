# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# IDE / 编辑器
.vscode/
.idea/
*.swp

# 测试与缓存
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# 项目运行产物（保留目录占位文件）
output/*
!output/.gitkeep
data/processed/*
!data/processed/.gitkeep

# 环境变量文件（含 DeepSeek API Key 等敏感信息，严禁提交）
.env
.env.*
!.env.example

# Phase 3：本地向量数据库（可随时用 rebuild 命令重建）
data/chroma/

# Phase 5：Streamlit 本地密钥（本项目的密钥统一放在 .env 中，这里仅作兜底忽略）
.streamlit/secrets.toml

# Phase 6：运营问题 SQLite 数据库（含 WAL 临时文件，可随时重建）
data/issues.db
data/issues.db-wal
data/issues.db-shm

# Excel 临时文件
~$*.xlsx
~$*.xls
